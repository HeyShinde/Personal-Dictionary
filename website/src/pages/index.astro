---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import AppSimulator from '../components/AppSimulator.astro';
import FeaturesBento from '../components/FeaturesBento.astro';
import AppleIntelligence from '../components/AppleIntelligence.astro';
import TechStack from '../components/TechStack.astro';
import InstallGuide from '../components/InstallGuide.astro';
---

<Layout 
  title="Personal Dictionary — AI-Powered Vocabulary for macOS"
  description="Master every word with a gorgeous, AI-powered macOS dictionary app. Dual-source definitions, IPA audio pronunciation, 20+ synonyms per word, and on-device Apple Intelligence — 100% offline & private."
>
  <!-- Hero Section -->
  <Hero />

  <!-- Live Interactive App Simulator -->
  <AppSimulator />

  <!-- Features Bento Grid -->
  <FeaturesBento />

  <!-- Apple Intelligence Deep Dive -->
  <AppleIntelligence />

  <!-- Native Architecture / Tech Stack -->
  <TechStack />

  <!-- Download & Installation Guide -->
  <InstallGuide />
</Layout>
