---
const GITHUB_REPO = "HeyShinde/Personal-Dictionary";
const GITHUB_URL = `https://github.com/${GITHUB_REPO}`;
const RELEASE_URL = `https://github.com/${GITHUB_REPO}/releases`;
const ISSUES_URL = `https://github.com/${GITHUB_REPO}/issues`;
---

<footer class="footer-wrapper">
  <div class="container footer-container">
    
    <div class="footer-top">
      <div class="footer-brand-col">
        <div class="footer-logo">
          <img src="/app-icon.png" alt="Personal Dictionary" width="32" height="32" />
          <span class="footer-brand-name">Personal Dictionary</span>
        </div>
        <p class="footer-tagline">
          A gorgeous, AI-powered macOS vocabulary companion.
          Built natively with Swift 6 and SwiftUI. Free and open source forever.
        </p>
        <div class="edge-badge">
          <span class="cloudflare-dot"></span>
          <span>Hosted on Cloudflare Pages • Built with Astro 7</span>
        </div>
      </div>

      <div class="footer-links-group">
        <div class="link-column">
          <h5>Product</h5>
          <a href="#features">Features</a>
          <a href="#demo">Live Demo</a>
          <a href="#ai">Apple Intelligence</a>
          <a href="#install">Download DMG</a>
        </div>

        <div class="link-column">
          <h5>Open Source</h5>
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub Repository</a>
          <a href={RELEASE_URL} target="_blank" rel="noopener noreferrer">Release History</a>
          <a href={ISSUES_URL} target="_blank" rel="noopener noreferrer">Report an Issue</a>
          <a href={`${GITHUB_URL}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer">MIT License</a>
        </div>

        <div class="link-column">
          <h5>Privacy & Terms</h5>
          <span class="footer-text-note">100% On-Device Privacy</span>
          <span class="footer-text-note">Zero Telemetry</span>
          <span class="footer-text-note">Zero User Accounts</span>
          <span class="footer-text-note">Offline First Architecture</span>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright-text">
        © 2026 Personal Dictionary. Built with ❤️ by <strong>Ajinkya Shinde</strong>.
      </p>

      <div class="social-links">
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>
      </div>
    </div>

  </div>
</footer>

<style>
  .footer-wrapper {
    border-top: 1px solid var(--border-subtle);
    background: rgba(8, 9, 13, 0.85);
    padding: 80px 0 40px;
    position: relative;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: 60px;
    margin-bottom: 60px;
  }

  .footer-brand-col {
    max-width: 360px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .footer-logo img {
    border-radius: 8px;
  }

  .footer-brand-name {
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .footer-tagline {
    font-size: 13.5px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .edge-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    color: #f97316;
    background: rgba(249, 115, 22, 0.1);
    border: 1px solid rgba(249, 115, 22, 0.25);
    padding: 4px 12px;
    border-radius: var(--radius-full);
  }

  .cloudflare-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #f97316;
  }

  .footer-links-group {
    display: flex;
    gap: 64px;
  }

  .link-column {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .link-column h5 {
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 4px;
  }

  .link-column a {
    font-size: 13.5px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .link-column a:hover {
    color: #ffffff;
  }

  .footer-text-note {
    font-size: 13px;
    color: var(--text-muted);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .copyright-text {
    font-size: 13px;
    color: var(--text-muted);
  }

  .copyright-text strong {
    color: #e2e8f0;
  }

  .social-links a {
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .social-links a:hover {
    color: #ffffff;
  }

  @media (max-width: 900px) {
    .footer-top {
      flex-direction: column;
      gap: 40px;
    }
    .footer-links-group {
      flex-wrap: wrap;
      gap: 40px;
    }
  }

  @media (max-width: 600px) {
    .footer-bottom {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }
  }
</style>

