---
const GITHUB_REPO = "HeyShinde/Personal-Dictionary";
const RELEASE_TAG = "v1.0.1";
const DOWNLOAD_URL = `https://github.com/${GITHUB_REPO}/releases/download/${RELEASE_TAG}/Personal-Dictionary-v1.0.1.dmg`;
const RELEASE_URL = `https://github.com/${GITHUB_REPO}/releases/tag/${RELEASE_TAG}`;
---

<section class="install-section" id="install">
  <div class="container">
    
    <div class="install-card glass-panel">
      
      <!-- Top CTA Header -->
      <div class="install-header">
        <div class="section-badge" style="background: rgba(16, 185, 129, 0.1); border-color: rgba(16, 185, 129, 0.25); color: #34d399;">
          Ready to Elevate Your Vocabulary?
        </div>

        <h2 class="install-title">
          Download Personal Dictionary<br />
          <span class="text-gradient">Free & Open Source on macOS.</span>
        </h2>

        <p class="install-subtitle">
          Built with care for writers, students, researchers, and polyglots.
          No subscriptions, no accounts, and 100% private.
        </p>

        <div class="install-cta-group">
          <a href={DOWNLOAD_URL} class="btn-glow-primary install-btn">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <span>Download DMG ({RELEASE_TAG})</span>
            <span class="cta-version-tag">3.9 MB</span>
          </a>

          <a href={RELEASE_URL} target="_blank" rel="noopener noreferrer" class="btn-glass-secondary">
            <span>Release Notes</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          </a>
        </div>

        <div class="install-meta-text">
          macOS 26+ <span>•</span> Apple Silicon <span>•</span> Swift 6 <span>•</span> MIT License
        </div>
      </div>

      <!-- Steps & Instructions -->
      <div class="steps-grid">
        
        <div class="step-card">
          <div class="step-number">1</div>
          <div class="step-content">
            <h4>Download the Disk Image</h4>
            <p>Click the download button above to get the official <code>Personal-Dictionary-v1.0.1.dmg</code> (only 3.9 MB).</p>
          </div>
        </div>

        <div class="step-card">
          <div class="step-number">2</div>
          <div class="step-content">
            <h4>Drag to Applications</h4>
            <p>Double-click the downloaded <code>.dmg</code> file, then drag the Personal Dictionary icon into your Applications folder.</p>
          </div>
        </div>

        <div class="step-card">
          <div class="step-number">3</div>
          <div class="step-content">
            <h4>First Launch (Gatekeeper)</h4>
            <p>Right-click the app icon in Applications and select <strong>Open</strong> to approve Gatekeeper for open-source software.</p>
          </div>
        </div>

        <div class="step-card">
          <div class="step-number">4</div>
          <div class="step-content">
            <h4>Enable Menu Bar Quick Add</h4>
            <p>Click the 📚 icon in your menu bar and check <strong>"Launch at Login"</strong> so your dictionary is always one keystroke away.</p>
          </div>
        </div>

      </div>

      <!-- Developer Build from Source Section -->
      <div class="source-build-box">
        <div class="source-build-header">
          <div class="source-build-title">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="16 18 22 12 16 6"/>
              <polyline points="8 6 2 12 8 18"/>
            </svg>
            <strong>Prefer to Build from Source with Xcode?</strong>
          </div>
          <span class="source-build-tag">Xcode 26+</span>
        </div>

        <div class="code-block-wrapper">
          <pre><code><span class="code-comment"># Clone the official repository</span>
git clone https://github.com/{GITHUB_REPO}.git
cd Personal-Dictionary

<span class="code-comment"># Open in Xcode and press Cmd+R to build & run</span>
open "Personal Dictionary.xcodeproj"</code></pre>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .install-section {
    padding: 80px 0 100px;
    position: relative;
  }

  .install-card {
    padding: 64px 48px;
    border-radius: var(--radius-xl);
    background: radial-gradient(circle at 50% 100%, rgba(99, 102, 241, 0.15) 0%, rgba(13, 14, 20, 0.95) 80%);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .install-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 56px;
  }

  .install-title {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 18px;
  }

  .install-subtitle {
    font-size: 16.5px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 32px;
  }

  .install-cta-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .install-btn {
    padding: 16px 36px;
    font-size: 16px;
  }

  .cta-version-tag {
    font-size: 11px;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.2);
    padding: 2px 8px;
    border-radius: 6px;
    margin-left: 2px;
  }

  .install-meta-text {
    font-size: 12.5px;
    color: var(--text-muted);
  }

  .install-meta-text span {
    margin: 0 8px;
  }

  /* Steps Grid */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 48px;
  }

  .step-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: all 0.2s ease;
  }

  .step-card:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.15);
  }

  .step-number {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent-gradient-start), var(--accent-gradient-end));
    color: #fff;
    font-size: 14px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .step-content h4 {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 6px;
  }

  .step-content p {
    font-size: 12.5px;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .step-content code {
    background: rgba(255, 255, 255, 0.08);
    color: #cbd5e1;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11.5px;
  }

  .step-content strong {
    color: #ffffff;
  }

  /* Source Build Box */
  .source-build-box {
    background: rgba(0, 0, 0, 0.45);
    border-radius: 14px;
    border: 1px solid var(--border-subtle);
    padding: 24px 28px;
  }

  .source-build-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .source-build-title {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #e2e8f0;
    font-size: 14px;
  }

  .source-build-tag {
    font-size: 11px;
    font-weight: 700;
    color: var(--accent-cyan);
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.25);
    padding: 3px 8px;
    border-radius: 6px;
  }

  .code-block-wrapper pre {
    margin: 0;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 8px;
    padding: 16px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12.5px;
    color: #f8fafc;
    line-height: 1.6;
    overflow-x: auto;
  }

  .code-comment {
    color: var(--text-muted);
  }

  @media (max-width: 1024px) {
    .steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .install-card {
      padding: 40px 20px;
    }
    .steps-grid {
      grid-template-columns: 1fr;
    }
    .install-cta-group {
      flex-direction: column;
      width: 100%;
    }
    .install-btn, .install-cta-group .btn-glass-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>
