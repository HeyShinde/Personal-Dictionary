---
const GITHUB_REPO = "HeyShinde/Personal-Dictionary";
const RELEASE_TAG = "v1.0.1";
const DOWNLOAD_URL = `https://github.com/${GITHUB_REPO}/releases/download/${RELEASE_TAG}/Personal-Dictionary-v1.0.1.dmg`;
const GITHUB_URL = `https://github.com/${GITHUB_REPO}`;
---

<section class="hero-section">
  <div class="container hero-container">
    
    <!-- Announcement Badge -->
    <div class="hero-pill-badge">
      <span class="live-indicator"></span>
      <span class="badge-text">v1.0.1 Now Available for macOS 26+</span>
      <span class="badge-sep">•</span>
      <span class="badge-highlight">Apple Silicon Native</span>
    </div>

    <!-- Main Heading -->
    <h1 class="hero-headline">
      Master Every Word.<br />
      <span class="text-gradient">Your Own Personal Lexicon.</span>
    </h1>

    <!-- Subtitle -->
    <p class="hero-subtext">
      The ultimate macOS vocabulary companion. Combines macOS system dictionary with cloud API fallback,
      rich Datamuse thesaurus, instant IPA audio pronunciation, and on-device
      <strong>Apple Intelligence</strong> insights — completely offline & private.
    </p>

    <!-- CTAs -->
    <div class="hero-buttons">
      <a href={DOWNLOAD_URL} class="btn-glow-primary hero-main-cta">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        <span>Download for macOS</span>
        <span class="cta-version-tag">3.9 MB</span>
      </a>

      <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="btn-glass-secondary">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        <span>Star on GitHub</span>
      </a>

      <button id="copy-clone-btn" class="quick-terminal-pill" title="Click to copy git clone command" aria-label="Copy git clone command">
        <span class="cmd-prompt">$</span>
        <code>git clone HeyShinde/Personal-Dictionary</code>
        <svg class="copy-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
          <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
        </svg>
        <span class="copied-tooltip">Copied!</span>
      </button>
    </div>

    <!-- Specs Bar -->
    <div class="hero-specs-bar">
      <div class="spec-item">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 3.5c.62-.75 1.04-1.8 0.93-2.85-.9.04-1.99.6-2.64 1.35-.58.66-1.09 1.73-.95 2.76 1.01.08 2.04-.51 2.66-1.26z"/>
        </svg>
        <span>macOS 26+ (Tahoe / Sequoia)</span>
      </div>
      <span class="spec-dot">•</span>
      <div class="spec-item">
        <span class="spec-icon">⚡</span>
        <span>Swift 6 & SwiftUI</span>
      </div>
      <span class="spec-dot">•</span>
      <div class="spec-item">
        <span class="spec-icon">✨</span>
        <span>Foundation Models AI</span>
      </div>
      <span class="spec-dot">•</span>
      <div class="spec-item">
        <span class="spec-icon">🛡️</span>
        <span>100% Free & Open Source</span>
      </div>
    </div>

  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: 150px;
    padding-bottom: 40px;
    text-align: center;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 18px;
    border-radius: var(--radius-full);
    background: rgba(99, 102, 241, 0.08);
    border: 1px solid rgba(99, 102, 241, 0.25);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: 13px;
    font-weight: 600;
    color: #cbd5e1;
    margin-bottom: 28px;
    box-shadow: 0 4px 20px rgba(99, 102, 241, 0.12);
  }

  .live-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-emerald);
    box-shadow: 0 0 10px var(--accent-emerald);
    animation: pulseDot 2s ease-in-out infinite;
  }

  .badge-sep {
    color: var(--text-muted);
  }

  .badge-highlight {
    color: #a5b4fc;
    font-weight: 700;
  }

  .hero-headline {
    font-size: clamp(40px, 6.5vw, 76px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.08;
    max-width: 950px;
    margin-bottom: 24px;
  }

  .hero-subtext {
    font-size: clamp(16px, 2.2vw, 20px);
    color: var(--text-secondary);
    max-width: 720px;
    line-height: 1.6;
    margin-bottom: 38px;
  }

  .hero-subtext strong {
    color: #f1f5f9;
  }

  .hero-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }

  .hero-main-cta {
    padding: 16px 32px;
    font-size: 16px;
  }

  .cta-version-tag {
    font-size: 11px;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.2);
    padding: 2px 8px;
    border-radius: 6px;
    margin-left: 2px;
  }

  .quick-terminal-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    padding: 12px 18px;
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    font-size: 13px;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
  }

  .quick-terminal-pill:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: var(--border-medium);
    color: var(--text-primary);
  }

  .cmd-prompt {
    color: var(--accent-emerald);
    font-weight: 700;
  }

  .copy-icon {
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .quick-terminal-pill:hover .copy-icon {
    opacity: 1;
  }

  .copied-tooltip {
    position: absolute;
    top: -28px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent-emerald);
    color: #000;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .quick-terminal-pill.copied .copied-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(-2px);
  }

  .hero-specs-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--text-muted);
    padding: 12px 24px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
  }

  .spec-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .spec-icon {
    font-size: 14px;
  }

  .spec-dot {
    color: rgba(255, 255, 255, 0.15);
  }

  @media (max-width: 768px) {
    .hero-section {
      padding-top: 120px;
    }

    .hero-buttons {
      flex-direction: column;
      width: 100%;
    }

    .hero-buttons > * {
      width: 100%;
      justify-content: center;
    }

    .hero-specs-bar {
      flex-direction: column;
      gap: 8px;
      border-radius: var(--radius-lg);
    }

    .spec-dot {
      display: none;
    }
  }
</style>

<script>
  const copyBtn = document.getElementById('copy-clone-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText('git clone https://github.com/HeyShinde/Personal-Dictionary.git');
      copyBtn.classList.add('copied');
      setTimeout(() => {
        copyBtn.classList.remove('copied');
      }, 2000);
    });
  }
</script>

