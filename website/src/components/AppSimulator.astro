</style>

<script>
  // Interactive Simulator Logic
  interface WordEntry {
    id: string;
    word: string;
    phonetic: string;
    pos: string;
    date: string;
    category: string;
    categoryIcon: string;
    isFavorite: boolean;
    definitions: string[];
    examples: string[];
    synonyms: string[];
    antonyms: string[];
    ai: {
      simple: string;
      sentence: string;
      mnemonic: string;
      tip: string;
    };
  }

  declare global {
    interface Window {
      __DICTIONARY_DB__: WordEntry[];
    }
  }

  const db: WordEntry[] = window.__DICTIONARY_DB__ || [];
  let currentWordId = 'venture';
  let filterFavorites = false;

  const searchInput = document.getElementById('word-search-input') as HTMLInputElement | null;
  const wordCounterEl = document.getElementById('word-counter');
  const filterFavBtn = document.getElementById('filter-fav-btn');

  // Detail elements
  const detailWord = document.getElementById('detail-word');
  const detailPhonetic = document.getElementById('detail-phonetic');
  const detailPos = document.getElementById('detail-pos');
  const detailCategory = document.getElementById('detail-category');
  const detailDate = document.getElementById('detail-date');
  const detailDefs = document.getElementById('detail-definitions');
  const detailSyns = document.getElementById('detail-synonyms');
  const detailAnts = document.getElementById('detail-antonyms');
  const detailExps = document.getElementById('detail-examples');
  const aiSimple = document.getElementById('ai-simple');
  const aiSentence = document.getElementById('ai-sentence');
  const aiMnemonic = document.getElementById('ai-mnemonic');
  const aiTip = document.getElementById('ai-tip');
  const speakBtn = document.getElementById('speak-audio-btn');
  const favToggleBtn = document.getElementById('toggle-fav-action');
  const openDictBtn = document.getElementById('open-dict-btn');

  function renderWord(wordObj: WordEntry) {
    if (!wordObj) return;
    currentWordId = wordObj.id;

    if (detailWord) detailWord.textContent = wordObj.word;
    if (detailPhonetic) detailPhonetic.textContent = wordObj.phonetic;
    if (detailPos) detailPos.textContent = wordObj.pos;
    if (detailCategory) detailCategory.textContent = `${wordObj.categoryIcon} ${wordObj.category}`;
    if (detailDate) detailDate.textContent = `📅 Added ${wordObj.date}`;

    // Render definitions
    if (detailDefs) {
      detailDefs.innerHTML = wordObj.definitions.map(d => `<li>${d}</li>`).join('');
    }

    // Render synonyms
    if (detailSyns) {
      detailSyns.innerHTML = wordObj.synonyms.map(s => 
        `<button class="syn-tag" data-word="${s}">${s}</button>`
      ).join('');

      // Add click handlers to tags
      detailSyns.querySelectorAll('.syn-tag').forEach(tag => {
        tag.addEventListener('click', (e) => {
          const targetWord = (e.currentTarget as HTMLElement).getAttribute('data-word');
          if (targetWord) {
            handleSynonymClick(targetWord);
          }
        });
      });
    }

    // Render antonyms
    if (detailAnts) {
      detailAnts.innerHTML = wordObj.antonyms.map(a => 
        `<span class="ant-tag">${a}</span>`
      ).join('');
    }

    // Render examples
    if (detailExps) {
      detailExps.innerHTML = wordObj.examples.map(ex => `<li>"${ex}"</li>`).join('');
    }

    // Render AI
    if (aiSimple) aiSimple.textContent = wordObj.ai.simple;
    if (aiSentence) aiSentence.textContent = wordObj.ai.sentence;
    if (aiMnemonic) aiMnemonic.textContent = wordObj.ai.mnemonic;
    if (aiTip) aiTip.textContent = wordObj.ai.tip;

    // Favorite state
    if (favToggleBtn) {
      favToggleBtn.classList.toggle('is-active', wordObj.isFavorite);
    }

    // Update active class in list
    document.querySelectorAll('.word-item').forEach(btn => {
      const match = btn.getAttribute('data-id') === wordObj.id;
      btn.classList.toggle('active', match);
      btn.setAttribute('aria-selected', match ? 'true' : 'false');
    });
  }

  function handleSynonymClick(synWord: string) {
    // If the word exists in our DB, select it!
    const found = db.find(w => w.word.toLowerCase() === synWord.toLowerCase());
    if (found) {
      renderWord(found);
    } else {
      // Temporarily speak the synonym or notify
      speakText(synWord);
    }
  }

  function speakText(text: string) {
    if (!('speechSynthesis' in window)) return;
    window.speechSynthesis.cancel();

    const utterance = new SpeechSynthesisUtterance(text);
    utterance.rate = 0.88;
    utterance.pitch = 1.0;

    if (speakBtn) {
      speakBtn.classList.add('speaking');
      utterance.onend = () => speakBtn.classList.remove('speaking');
      utterance.onerror = () => speakBtn.classList.remove('speaking');
    }

    window.speechSynthesis.speak(utterance);
  }

  // Speak Button Handler
  if (speakBtn) {
    speakBtn.addEventListener('click', () => {
      const current = db.find(w => w.id === currentWordId);
      if (current) {
        speakText(current.word);
      }
    });
  }

  // Toggle Favorite Handler
  if (favToggleBtn) {
    favToggleBtn.addEventListener('click', () => {
      const current = db.find(w => w.id === currentWordId);
      if (current) {
        current.isFavorite = !current.isFavorite;
        favToggleBtn.classList.toggle('is-active', current.isFavorite);
        // Also update list item star
        const listItem = document.querySelector(`.word-item[data-id="${current.id}"]`);
        if (listItem) {
          listItem.setAttribute('data-fav', current.isFavorite ? 'true' : 'false');
          let star = listItem.querySelector('.word-item-star');
          if (current.isFavorite && !star) {
            const nameRow = listItem.querySelector('.word-name-row');
            if (nameRow) {
              const newStar = document.createElement('span');
              newStar.className = 'word-item-star';
              newStar.textContent = '★';
              nameRow.appendChild(newStar);
            }
          } else if (!current.isFavorite && star) {
            star.remove();
          }
        }
      }
    });
  }

  // Filter Favorites Handler
  if (filterFavBtn) {
    filterFavBtn.addEventListener('click', () => {
      filterFavorites = !filterFavorites;
      filterFavBtn.classList.toggle('active', filterFavorites);
      filterList();
    });
  }

  // Filter search input
  function filterList() {
    const query = (searchInput?.value || '').toLowerCase().trim();
    let visibleCount = 0;

    document.querySelectorAll('.word-item').forEach(el => {
      const itemEl = el as HTMLElement;
      const word = (itemEl.getAttribute('data-word') || '').toLowerCase();
      const isFav = itemEl.getAttribute('data-fav') === 'true';

      const matchesQuery = query === '' || word.includes(query);
      const matchesFav = !filterFavorites || isFav;

      if (matchesQuery && matchesFav) {
        itemEl.style.display = 'flex';
        visibleCount++;
      } else {
        itemEl.style.display = 'none';
      }
    });

    if (wordCounterEl) {
      wordCounterEl.textContent = `${visibleCount} word${visibleCount === 1 ? '' : 's'}`;
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', filterList);
  }

  // Keyboard shortcut: Cmd+K focuses search
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      searchInput?.focus();
    }
  });

  // Attach word list click events
  document.querySelectorAll('.word-item').forEach(item => {
    item.addEventListener('click', (e) => {
      const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
      const found = db.find(w => w.id === id);
      if (found) {
        renderWord(found);
      }
    });
  });

  // System dictionary button toast/simulation
  if (openDictBtn) {
    openDictBtn.addEventListener('click', () => {
      const current = db.find(w => w.id === currentWordId);
      const word = current ? current.word : 'venture';
      alert(`In the native macOS app, clicking this opens Dictionary.app with the full definition for "${word}".`);
    });
  }
</script>
