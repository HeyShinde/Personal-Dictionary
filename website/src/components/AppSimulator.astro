---
// Word data for the interactive macOS Simulator
const WORDS_DATABASE = [
  {
    id: "venture",
    word: "venture",
    phonetic: "ˈven(t)SHər",
    pos: "noun",
    date: "3 May 2026",
    category: "Business",
    categoryIcon: "💼",
    isFavorite: true,
    definitions: [
      "A risky or daring journey or undertaking.",
      "A commercial enterprise or business undertaking involving considerable financial or operational risk.",
      "To dare to do or say something that may be considered audacious or controversial."
    ],
    examples: [
      "He invested all his savings into an AI venture that paid off handsomely.",
      "She ventured into uncharted territory with her groundbreaking research.",
      "Few entrepreneurs dared to venture into the space industry before the new wave."
    ],
    synonyms: ["enterprise", "undertaking", "project", "endeavor", "gamble", "exploit", "adventure", "speculation"],
    antonyms: ["certainty", "assurance", "safety", "inaction", "sure thing"],
    ai: {
      simple: "Think of a venture like jumping into something exciting but uncertain — like launching a startup or venturing into the deep woods with a compass.",
      sentence: "Launching their open-source macOS app was an ambitious venture, but one that soon gained thousands of dedicated writers and linguists.",
      mnemonic: "Remember: 'Venture' shares its root with 'adVENTURE' — both require daring courage!",
      tip: "Use 'joint venture' when two companies collaborate on a project; use 'venture forth' for dramatic or poetic movement."
    }
  },
  {
    id: "serendipity",
    word: "serendipity",
    phonetic: "ˌserənˈdipədē",
    pos: "noun",
    date: "14 May 2026",
    category: "Philosophy",
    categoryIcon: "✨",
    isFavorite: true,
    definitions: [
      "The occurrence and development of events by chance in a happy or beneficial way.",
      "Good fortune or luck in discovering pleasant or valuable things without intentionally seeking them."
    ],
    examples: [
      "Finding my favorite rare book at a small corner thrift store was pure serendipity.",
      "A touch of serendipity led the biochemist to observe the unexpected crystal formation.",
      "Their chance meeting at the airport was a moment of life-changing serendipity."
    ],
    synonyms: ["fluke", "happy chance", "providence", "blessing", "good fortune", "coincidence", "kismet"],
    antonyms: ["misfortune", "bad luck", "premeditation", "design", "deliberate plan"],
    ai: {
      simple: "Finding twenty dollars in the pocket of an old winter coat you haven't worn in months — finding joyful treasures by accident.",
      sentence: "By pure serendipity, glancing through the library catalog introduced him to the exact 19th-century manuscript he didn't know he needed.",
      mnemonic: "Coined by Horace Walpole from the Persian fairy tale 'The Three Princes of Serendip' who were always discovering wonders by chance.",
      tip: "Often used as an adjective: 'serendipitous discovery'. Expresses an upbeat, grateful tone."
    }
  },
  {
    id: "ephemeral",
    word: "ephemeral",
    phonetic: "əˈfem(ə)rəl",
    pos: "adjective",
    date: "28 May 2026",
    category: "Literature",
    categoryIcon: "📖",
    isFavorite: false,
    definitions: [
      "Lasting for a very short time; transitory; fleeting.",
      "(Of a plant) having a very short life cycle, typically completing its cycle in a few weeks.",
      "(Chiefly of paper or collectable items) designed for short-term use and not intended to be preserved."
    ],
    examples: [
      "Fame in the digital age can be notoriously ephemeral.",
      "The morning mist over the harbor was ephemeral, burning off as soon as the sun crested.",
      "Poets have long celebrated the ephemeral beauty of cherry blossoms in April."
    ],
    synonyms: ["transient", "fleeting", "evanescent", "short-lived", "momentary", "fugitive", "brief"],
    antonyms: ["eternal", "permanent", "everlasting", "perpetual", "enduring", "imperishable"],
    ai: {
      simple: "Something that vanishes like a soap bubble or morning dew: vivid, precious, but here for only a fleeting instant.",
      sentence: "The vibrant colors of the sunset were breathtakingly ephemeral, fading into indigo within minutes.",
      mnemonic: "From Greek 'ephemeros' (epi = on, hemera = day) — literally lasting just for a day!",
      tip: "Often pairs with abstract nouns: 'ephemeral fame', 'ephemeral joy', 'ephemeral trends'."
    }
  },
  {
    id: "eloquent",
    word: "eloquent",
    phonetic: "ˈeləkwənt",
    pos: "adjective",
    date: "2 June 2026",
    category: "General",
    categoryIcon: "🗣️",
    isFavorite: true,
    definitions: [
      "Fluent or persuasive in speaking or writing.",
      "Clearly expressing or indicating something deep, powerful, or poignant without words."
    ],
    examples: [
      "Her eloquent keynote address moved the entire auditorium to a standing ovation.",
      "His prolonged silence was more eloquent than any speech he could have delivered.",
      "The architect's design stood as an eloquent tribute to minimalist principles."
    ],
    synonyms: ["articulate", "persuasive", "expressive", "fluent", "silver-tongued", "poignant", "rhetorical"],
    antonyms: ["inarticulate", "tongue-tied", "hesitant", "clumsy", "stammering"],
    ai: {
      simple: "Expressing thoughts so smoothly and gracefully that listeners are captivated, whether through spoken poetry or a silent glance.",
      sentence: "An eloquent speaker doesn't just inform an audience; they evoke vivid pictures in their minds.",
      mnemonic: "Shares Latin root 'loqui' (to speak) with 'dialogue', 'loquacious', and 'soliloquy'.",
      tip: "Can describe people ('an eloquent advocate') or non-verbal gestures ('an eloquent silence', 'an eloquent gaze')."
    }
  },
  {
    id: "petrichor",
    word: "petrichor",
    phonetic: "ˈpetrəˌkôr",
    pos: "noun",
    date: "12 June 2026",
    category: "Science",
    categoryIcon: "🌧️",
    isFavorite: false,
    definitions: [
      "A pleasant, distinctive smell that frequently accompanies the first rain after a long period of warm, dry weather.",
      "The earthy scent produced when rain falls on dry soil, caused by aerosolization of geosmin and plant oils."
    ],
    examples: [
      "As the summer thunderstorm broke, the sweet petrichor drifted through the open bedroom window.",
      "Scientists discovered that the petrichor aroma is primarily released when raindrops trap tiny air bubbles against dusty earth.",
      "Nothing evokes nostalgic memories of childhood summers quite like the scent of petrichor."
    ],
    synonyms: ["earthy scent", "rain aroma", "soil fragrance", "geosmin smell"],
    antonyms: ["stale air", "mustiness"],
    ai: {
      simple: "That unmistakable, refreshing scent when sudden raindrops hit hot summer pavement or dry garden soil.",
      sentence: "Stepping outside onto the veranda after the sudden downpour, she inhaled the intoxicating petrichor.",
      mnemonic: "From Greek 'petra' (stone) + 'ichor' (the ethereal fluid that flowed in the veins of the Greek gods)!",
      tip: "Scientific yet deeply poetic; often featured in creative writing when setting atmospheric outdoor scenes."
    }
  },
  {
    id: "sonder",
    word: "sonder",
    phonetic: "ˈsändər",
    pos: "noun",
    date: "25 June 2026",
    category: "Daily Life",
    categoryIcon: "☕",
    isFavorite: true,
    definitions: [
      "The profound realization that each random passerby is living a life as vivid and complex as your own.",
      "An awareness that everyone you pass has their own intricate web of dreams, heartbreaks, routines, and loved ones."
    ],
    examples: [
      "Sitting in the bustling Tokyo subway station, a wave of sonder washed over him as thousands moved past.",
      "Looking out at the lighted high-rise apartment windows at midnight filled her with intense sonder.",
      "It takes a moment of sonder to realize that you are merely a nameless background extra in someone else's epic story."
    ],
    synonyms: ["empathic realization", "perspective shift", "human connection", "existential awareness"],
    antonyms: ["solipsism", "egocentrism", "insularity"],
    ai: {
      simple: "Realizing that every person waiting at the red light with you has a whole universe inside their head with hopes, secrets, and late-night worries.",
      sentence: "Standing on the pedestrian bridge at rush hour, the feeling of sonder reminded him how interconnected humanity truly is.",
      mnemonic: "Coined by John Koenig in 'The Dictionary of Obscure Sorrows' — related to the German 'sonder-' (special).",
      tip: "A modern neologism that has gained widespread cultural resonance for describing empathy in busy urban landscapes."
    }
  }
];
---

<section class="simulator-section" id="demo">
  <div class="container">
    
    <div class="simulator-header">
      <div class="section-badge">Live Interactive Simulator</div>
      <h2 class="section-title">
        Experience Personal Dictionary<br />
        <span class="text-gradient">Right in Your Browser.</span>
      </h2>
      <p class="section-subtitle">
        Click between words, test the audio pronunciation with Web Speech, filter the vocabulary,
        and explore dual-source definitions alongside on-device Apple Intelligence.
      </p>
    </div>

    <!-- macOS Window Mockup -->
    <div class="macos-window glass-panel" id="macos-simulator">
      
      <!-- macOS Window Titlebar -->
      <div class="macos-titlebar">
        <div class="traffic-lights">
          <button class="traffic-btn close" title="Close" aria-label="Close window">
            <svg viewBox="0 0 10 10" width="6" height="6"><path d="M1 1l8 8m0-8L1 9" stroke="#4d0000" stroke-width="1.4"/></svg>
          </button>
          <button class="traffic-btn minimize" title="Minimize" aria-label="Minimize window">
            <svg viewBox="0 0 10 10" width="6" height="6"><path d="M1 5h8" stroke="#5a3d00" stroke-width="1.4"/></svg>
          </button>
          <button class="traffic-btn maximize" title="Zoom" aria-label="Zoom window">
            <svg viewBox="0 0 10 10" width="6" height="6"><path d="M1 9l8-8M9 5V1H5M1 5v4h4" stroke="#003e00" stroke-width="1.2"/></svg>
          </button>
        </div>
        
        <div class="window-title-box">
          <img src="/app-icon.png" alt="App Icon" width="16" height="16" class="window-mini-icon" />
          <span class="window-title">Personal Dictionary — Sequoia Edition</span>
        </div>

        <div class="window-actions">
          <button class="window-action-btn" id="filter-fav-btn" title="Filter Favorites" aria-label="Filter Favorites">
            <span class="star-icon">★</span>
            <span class="action-label">Favorites</span>
          </button>
          <div class="window-badge-pill">macOS 26</div>
        </div>
      </div>

      <!-- App Body (Sidebar + Split Detail) -->
      <div class="macos-body">
        
        <!-- Sidebar -->
        <aside class="macos-sidebar">
          <div class="sidebar-top">
            <div class="sidebar-header">
              <h3>My Vocabulary</h3>
              <span class="word-counter" id="word-counter">{WORDS_DATABASE.length} words</span>
            </div>
            
            <!-- Search Box -->
            <div class="search-box">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" class="search-icon">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
              <input 
                type="text" 
                id="word-search-input" 
                placeholder="Search or ⌘K..." 
                aria-label="Search words" 
                autocomplete="off"
              />
              <span class="search-kbd">⌘K</span>
            </div>
          </div>

          <!-- Words List -->
          <div class="words-list" id="words-list" role="listbox">
            {WORDS_DATABASE.map((item, index) => (
              <button 
                class={`word-item ${index === 0 ? 'active' : ''}`}
                data-id={item.id}
                data-word={item.word}
                data-fav={item.isFavorite ? 'true' : 'false'}
                role="option"
                aria-selected={index === 0 ? 'true' : 'false'}
              >
                <div class="word-item-info">
                  <div class="word-name-row">
                    <span class="word-item-title">{item.word}</span>
                    {item.isFavorite && <span class="word-item-star" title="Favorite">★</span>}
                  </div>
                  <div class="word-meta-row">
                    <span class="word-item-pos">{item.pos}</span>
                    <span class="word-item-cat">{item.categoryIcon} {item.category}</span>
                  </div>
                </div>
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="chevron-icon">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </button>
            ))}
          </div>

          <div class="sidebar-footer">
            <div class="quick-add-tip">
              <span class="tip-kbd">Services</span>
              <span>Right-click any word ➔ Add to Dictionary</span>
            </div>
          </div>
        </aside>

        <!-- Detail Pane -->
        <main class="macos-detail" id="word-detail-pane">
          
          <!-- Detail Header -->
          <div class="detail-header">
            <div class="detail-title-group">
              <div class="title-with-actions">
                <h1 class="active-word-title" id="detail-word">venture</h1>
                
                <button class="speak-btn" id="speak-audio-btn" title="Speak pronunciation using Web Speech">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" class="audio-icon">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/>
                  </svg>
                  <span class="speak-label">Pronounce</span>
                  <div class="sound-wave" id="sound-wave">
                    <span></span><span></span><span></span><span></span>
                  </div>
                </button>

                <button class="favorite-toggle-btn" id="toggle-fav-action" title="Toggle favorite">
                  <span class="fav-icon filled" id="fav-star-icon">★</span>
                </button>
              </div>

              <!-- Phonetic & Tags Bar -->
              <div class="phonetic-meta-bar">
                <span class="phonetic-badge" id="detail-phonetic">ˈven(t)SHər</span>
                <span class="pos-badge" id="detail-pos">noun</span>
                <span class="category-badge" id="detail-category">💼 Business</span>
                <span class="date-badge" id="detail-date">📅 Added 3 May 2026</span>
              </div>
            </div>

            <div class="system-dict-link-box">
              <button class="system-dict-btn" id="open-dict-btn" title="Simulate opening in macOS Dictionary.app">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                  <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                </svg>
                <span>Dictionary.app</span>
              </button>
            </div>
          </div>

          <!-- Cards Scroll Area -->
          <div class="detail-cards-stack">
            
            <!-- Definitions Card -->
            <div class="detail-card glass-panel-inner def-card">
              <div class="card-header">
                <div class="card-icon def-icon">📝</div>
                <div class="card-title-group">
                  <h3>Dual-Source Definitions</h3>
                  <span class="source-tag">macOS System Dictionary + API</span>
                </div>
              </div>
              <ol class="definitions-list" id="detail-definitions">
                <li>A risky or daring journey or undertaking.</li>
                <li>A commercial enterprise or business undertaking involving considerable financial or operational risk.</li>
                <li>To dare to do or say something that may be considered audacious or controversial.</li>
              </ol>
            </div>

            <!-- Apple Intelligence Card -->
            <div class="detail-card glass-panel-inner ai-card">
              <div class="card-header">
                <div class="card-icon ai-icon">✨</div>
                <div class="card-title-group">
                  <h3>Apple Intelligence Insights</h3>
                  <span class="source-tag ai-tag">On-Device Foundation Models</span>
                </div>
              </div>
              
              <div class="ai-tabs-grid">
                <div class="ai-item">
                  <div class="ai-item-head">
                    <span class="ai-item-emoji">💡</span>
                    <strong>Simple Explanation</strong>
                  </div>
                  <p id="ai-simple">Think of a venture like jumping into something exciting but uncertain — like launching a startup or venturing into the deep woods with a compass.</p>
                </div>

                <div class="ai-item">
                  <div class="ai-item-head">
                    <span class="ai-item-emoji">✍️</span>
                    <strong>Memorable Sentence</strong>
                  </div>
                  <p id="ai-sentence">Launching their open-source macOS app was an ambitious venture, but one that soon gained thousands of dedicated writers and linguists.</p>
                </div>

                <div class="ai-item">
                  <div class="ai-item-head">
                    <span class="ai-item-emoji">🧠</span>
                    <strong>Memory Trick & Etymology</strong>
                  </div>
                  <p id="ai-mnemonic">Remember: 'Venture' shares its root with 'adVENTURE' — both require daring courage!</p>
                </div>

                <div class="ai-item">
                  <div class="ai-item-head">
                    <span class="ai-item-emoji">📝</span>
                    <strong>Usage Guidance</strong>
                  </div>
                  <p id="ai-tip">Use 'joint venture' when two companies collaborate on a project; use 'venture forth' for dramatic or poetic movement.</p>
                </div>
              </div>
            </div>

            <!-- Thesaurus & Synonyms Card -->
            <div class="detail-card glass-panel-inner syn-card">
              <div class="card-header">
                <div class="card-icon syn-icon">🔤</div>
                <div class="card-title-group">
                  <h3>Rich Thesaurus</h3>
                  <span class="source-tag">Datamuse API (Flow Layout)</span>
                </div>
              </div>
              
              <div class="syn-section">
                <div class="syn-label">Synonyms ({WORDS_DATABASE[0].synonyms.length})</div>
                <div class="tags-cloud" id="detail-synonyms">
                  {WORDS_DATABASE[0].synonyms.map(syn => (
                    <button class="syn-tag" data-word={syn}>{syn}</button>
                  ))}
                </div>
              </div>

              <div class="syn-section" style="margin-top: 14px;">
                <div class="syn-label">Antonyms ({WORDS_DATABASE[0].antonyms.length})</div>
                <div class="tags-cloud antonyms" id="detail-antonyms">
                  {WORDS_DATABASE[0].antonyms.map(ant => (
                    <span class="ant-tag">{ant}</span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Usage Examples Card -->
            <div class="detail-card glass-panel-inner exp-card">
              <div class="card-header">
                <div class="card-icon exp-icon">💬</div>
                <div class="card-title-group">
                  <h3>Real-World Usage Examples</h3>
                  <span class="source-tag">Literary & Modern Context</span>
                </div>
              </div>
              <ul class="examples-list" id="detail-examples">
                {WORDS_DATABASE[0].examples.map(exp => (
                  <li>"{exp}"</li>
                ))}
              </ul>
            </div>

          </div>
        </main>
      </div>

      <!-- Simulator Bottom Bar -->
      <div class="macos-statusbar">
        <div class="status-left">
          <span class="status-dot"></span>
          <span>SwiftData Engine Connected • Local Storage • Zero Network Latency</span>
        </div>
        <div class="status-right">
          <span>Click any word or synonym to inspect</span>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- Pass words database to client script safely -->
<script define:vars={{ wordsDb: WORDS_DATABASE }}>
  window.__DICTIONARY_DB__ = wordsDb;
</script>

<style>
  .simulator-section {
    padding: 60px 0 100px;
    position: relative;
  }

  .simulator-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 48px;
  }

  /* macOS Window Frame */
  .macos-window {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    background: rgba(14, 16, 23, 0.85);
    backdrop-filter: blur(32px) saturate(200%);
    -webkit-backdrop-filter: blur(32px) saturate(200%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 
      0 30px 100px rgba(0, 0, 0, 0.75),
      0 0 80px rgba(99, 102, 241, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
  }

  /* Titlebar */
  .macos-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    user-select: none;
  }

  .traffic-lights {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .traffic-btn {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: transform 0.15s ease;
  }

  .traffic-btn svg {
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .traffic-lights:hover .traffic-btn svg {
    opacity: 0.75;
  }

  .traffic-btn.close { background: #ff5f57; box-shadow: inset 0 1px 1px rgba(0,0,0,0.2); }
  .traffic-btn.minimize { background: #febc2e; box-shadow: inset 0 1px 1px rgba(0,0,0,0.2); }
  .traffic-btn.maximize { background: #28c840; box-shadow: inset 0 1px 1px rgba(0,0,0,0.2); }

  .window-title-box {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .window-mini-icon {
    border-radius: 4px;
  }

  .window-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    letter-spacing: -0.01em;
  }

  .window-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .window-action-btn {
    display: flex;
    align-items: center;
    gap: 5px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .window-action-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .window-action-btn.active {
    background: rgba(245, 158, 11, 0.2);
    border-color: rgba(245, 158, 11, 0.4);
    color: var(--accent-amber);
  }

  .window-badge-pill {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    padding: 3px 8px;
    border-radius: 6px;
  }

  /* Body Layout */
  .macos-body {
    display: grid;
    grid-template-columns: 290px 1fr;
    min-height: 600px;
    max-height: 720px;
  }

  /* Sidebar */
  .macos-sidebar {
    background: rgba(8, 10, 15, 0.5);
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .sidebar-top {
    padding: 18px 16px 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .sidebar-header h3 {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .word-counter {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.06);
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 8px 12px;
    transition: all 0.2s ease;
  }

  .search-box:focus-within {
    border-color: var(--accent-primary);
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 0 12px rgba(99, 102, 241, 0.25);
  }

  .search-icon {
