---
const AI_PILLARS = [
  {
    id: "simple",
    title: "Simple Explanation",
    icon: "💡",
    tagline: "Plain-English clarity",
    desc: "Bypasses stiff academic dictionary jargon. Translates complex linguistic definitions into everyday conceptual language you can instantly visualize.",
    example: "Instead of 'a speculative venture subject to probabilistic variance', Apple Intelligence explains: 'Like setting up a hot chocolate stand in winter — exciting, but you are not yet sure how many people will walk by.'"
  },
  {
    id: "sentence",
    title: "Memorable Sentence",
    icon: "✍️",
    tagline: "Vivid retention narratives",
    desc: "Generates evocative, story-driven sentences rather than bland textbook samples. Contextualizes the word within sensory, dramatic, or modern scenarios.",
    example: "'The team's midnight software deployment was a daring venture into uncharted territory, with millions watching the live dashboard.'"
  },
  {
    id: "trick",
    title: "Memory Trick (Mnemonic)",
    icon: "🧠",
    tagline: "Cognitive anchors & etymology",
    desc: "Uncovers hidden etymology, sound associations, and visual mnemonics so the word sticks in long-term memory after a single reading.",
    example: "'VENTURE connects directly to adVENTURE and inVENT: all three require stepping boldly into the unknown with courage.'"
  },
  {
    id: "tip",
    title: "Contextual Usage Tip",
    icon: "📝",
    tagline: "Nuance & stylistic register",
    desc: "Guides you on when and where to employ the word. Identifies whether it fits formal speeches, academic papers, casual dialogue, or poetic verse.",
    example: "'Pair with prepositions: venture INTO (enter boldly), venture ON (stake money/pride), or venture TO DO (hesitantly attempt).'"
  }
];
---

<section class="ai-spotlight-section" id="ai">
  <div class="container">
    
    <div class="ai-spotlight-box glass-panel">
      <!-- Glow Border -->
      <div class="ai-rainbow-line"></div>

      <div class="ai-header-content">
        <div class="ai-chip">
          <span class="ai-star">✨</span>
          <span>Powered by Apple Foundation Models</span>
        </div>

        <h2 class="ai-main-title">
          Supercharged by <span class="text-gradient">Apple Intelligence.</span>
        </h2>

        <p class="ai-main-desc">
          Vocabulary learning reimagined with native on-device Foundation Models.
          Generate contextual pedagogical insights for every word you save — 
          <strong>100% private, zero cloud latency, and works completely offline.</strong>
        </p>
      </div>

      <!-- Pillars Cards Grid -->
      <div class="ai-pillars-grid">
        {AI_PILLARS.map((pillar) => (
          <div class="pillar-card">
            <div class="pillar-header">
              <span class="pillar-icon">{pillar.icon}</span>
              <div>
                <h4>{pillar.title}</h4>
                <span class="pillar-tagline">{pillar.tagline}</span>
              </div>
            </div>
            
            <p class="pillar-desc">{pillar.desc}</p>
            
            <div class="pillar-example-box">
              <span class="example-quote-icon">“</span>
              <p>{pillar.example}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Apple Intelligence Specs Banner -->
      <div class="ai-footer-specs">
        <div class="spec-cell">
          <strong>Private by Design</strong>
          <span>Inference runs locally on the Apple Neural Engine</span>
        </div>
        <div class="spec-divider"></div>
        <div class="spec-cell">
          <strong>Instant Generation</strong>
          <span>Microsecond response times without server queues</span>
        </div>
        <div class="spec-divider"></div>
        <div class="spec-cell">
          <strong>System Requirements</strong>
          <span>Apple Silicon Mac • macOS 26 (Tahoe) or later</span>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .ai-spotlight-section {
    padding: 80px 0 100px;
    position: relative;
  }

  .ai-spotlight-box {
    position: relative;
    padding: 64px 56px;
    background: radial-gradient(circle at 50% 0%, rgba(99, 102, 241, 0.12) 0%, rgba(14, 16, 24, 0.95) 75%);
    border: 1px solid rgba(168, 85, 247, 0.25);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 20px 80px rgba(0, 0, 0, 0.6), 0 0 60px rgba(168, 85, 247, 0.1);
  }

  .ai-rainbow-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #6366f1, #a855f7, #ec4899, #38bdf8, #6366f1);
    background-size: 200% 100%;
    animation: rainbowBorder 6s linear infinite;
  }

  .ai-header-content {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 56px;
  }

  .ai-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-radius: var(--radius-full);
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.3);
    color: #d8b4fe;
    font-size: 12.5px;
    font-weight: 700;
    margin-bottom: 20px;
  }

  .ai-star {
    font-size: 14px;
  }

  .ai-main-title {
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: 18px;
    line-height: 1.15;
  }

  .ai-main-desc {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .ai-main-desc strong {
    color: #f1f5f9;
  }

  /* Pillars Grid */
  .ai-pillars-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 48px;
  }

  .pillar-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .pillar-card:hover {
    transform: translateY(-2px);
    border-color: rgba(168, 85, 247, 0.35);
    background: rgba(255, 255, 255, 0.05);
  }

  .pillar-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .pillar-icon {
    font-size: 24px;
    background: rgba(255, 255, 255, 0.06);
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pillar-header h4 {
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .pillar-tagline {
    font-size: 12px;
    color: #c084fc;
    font-weight: 600;
  }

  .pillar-desc {
    font-size: 13.5px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .pillar-example-box {
    background: rgba(0, 0, 0, 0.35);
    border-radius: 10px;
    border-left: 3px solid #c084fc;
    padding: 12px 14px 12px 16px;
    position: relative;
  }

  .example-quote-icon {
    display: none;
  }

  .pillar-example-box p {
    font-size: 12.5px;
    color: #cbd5e1;
    font-style: italic;
    line-height: 1.5;
  }

  /* Footer Specs */
  .ai-footer-specs {
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 24px 32px;
    background: rgba(0, 0, 0, 0.4);
    border-radius: 14px;
    border: 1px solid var(--border-subtle);
  }

  .spec-cell {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: center;
  }

  .spec-cell strong {
    font-size: 14px;
    color: #ffffff;
    font-weight: 700;
  }

  .spec-cell span {
    font-size: 12px;
    color: var(--text-muted);
  }

  .spec-divider {
    width: 1px;
    height: 36px;
    background: var(--border-subtle);
  }

  @media (max-width: 900px) {
    .ai-spotlight-box {
      padding: 40px 24px;
    }

    .ai-pillars-grid {
      grid-template-columns: 1fr;
    }

    .ai-footer-specs {
      flex-direction: column;
      gap: 16px;
      padding: 20px;
    }

    .spec-divider {
      width: 100%;
      height: 1px;
    }
  }
</style>

